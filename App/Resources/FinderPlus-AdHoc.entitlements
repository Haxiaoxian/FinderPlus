<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used for builds without a Team ID (ad-hoc signed downloads). No App Group: data is shared
	     through ~/Library/Application Support/FinderPlus/Shared instead. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
